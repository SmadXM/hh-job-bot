# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat ID (see README for how to find it)
TELEGRAM_CHAT_ID=

# ── Gemini ────────────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey (free tier is enough)
GEMINI_API_KEY=

# ── Search settings ───────────────────────────────────────────────────────────
SEARCH_INTERVAL_HOURS=3
SEARCH_QUERY=C# developer
# hh.ru area ID: 1  = Moscow, 2 = Saint-Petersburg, 1202 = Novosibirsk
SEARCH_CITY_ID=1202
SEARCH_SALARY_FROM=80000
# Schedule: remote | fullDay | shift | flexible
SEARCH_SCHEDULE=remote
